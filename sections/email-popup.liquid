{% assign newsletter_success = false %}

<!-- Email Popup -->
<div id="emailPopup" class="fixed inset-0 z-50 popup-overlay hidden items-center justify-center p-4">
    <div class="popup-content glass-effect rounded-3xl p-8 md:p-12 max-w-md w-full relative">
        <button onclick="closeEmailPopup()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
        
        <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-6 animate-pulse-glow">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">
                <span class="gradient-text">-10% Supplémentaire !</span>
            </h2>
            
            <p class="text-gray-600 mb-2 text-lg">
                Recevez un code promo exclusif de <span class="font-bold text-pink-600">-10%</span> supplémentaire
            </p>
            <p class="text-gray-500 text-sm mb-6">
                En plus de votre réduction actuelle, pour votre première commande
            </p>
            
            {% form 'customer', id: 'emailForm', class: 'space-y-4' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {% if form.posted_successfully? %}
                {% assign newsletter_success = true %}
                <div class="text-center">
                    <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <h2 class="font-display text-3xl font-bold mb-4 text-gray-800">
                        Merci ! 🎉
                    </h2>
                    <p class="text-gray-600 mb-4">
                        Votre code promo arrive par email.
                    </p>
                    <button type="button" onclick="closeEmailPopup()" class="px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-lg hover:scale-105 transition-transform duration-300">
                        Parfait, Merci !
                    </button>
                </div>
                {% else %}
                <div>
                    <input 
                        type="email" 
                        name="contact[email]"
                        value="{{ form.email }}"
                        required
                        placeholder="Votre adresse email" 
                        class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none input-focus transition-all text-center"
                    >
                </div>
                {% if form.errors %}
                <div class="text-sm text-red-500">
                    {{ form.errors | default_errors }}
                </div>
                {% endif %}
                <button 
                    type="submit" 
                    class="w-full px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-lg hover:scale-105 transition-transform duration-300 animate-pulse-glow"
                >
                    Recevoir Mon Code Promo
                </button>
                <p class="text-xs text-gray-400 mt-4">
                    En vous inscrivant, vous acceptez de recevoir nos offres exclusives
                </p>
                {% endif %}
            {% endform %}
        </div>
    </div>
</div>

{% if newsletter_success %}
<script>
  localStorage.setItem('emailPopupShown', 'true');
  const popup = document.getElementById('emailPopup');
  if (popup) {
    popup.classList.remove('hidden');
    popup.classList.add('flex');
  }
</script>
{% endif %}

{% schema %}
{
  "name": "Email Popup",
  "settings": []
}
{% endschema %}
