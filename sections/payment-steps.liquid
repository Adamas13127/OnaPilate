{% assign payment_product = all_products[section.settings.product] %}
{% if payment_product == blank %}
  {% assign payment_product = all_products[settings.main_product] %}
{% endif %}
{% if payment_product == blank and collections.all.products.first %}
  {% assign payment_product = collections.all.products.first %}
{% endif %}

<section class="py-20 px-6 bg-gradient-to-br from-pink-50 via-purple-50 to-white relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-10 right-10 w-64 h-64 bg-pink-200/20 rounded-full blur-3xl animate-float"></div>
        <div class="absolute bottom-10 left-10 w-80 h-80 bg-purple-200/20 rounded-full blur-3xl animate-float delay-500"></div>
    </div>

    <div class="container mx-auto relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-12 animate-fade-in-up">
            <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">
                <span class="gradient-text">{{ section.settings.title }}</span>
            </h1>
            <p class="text-lg text-gray-600">
                {{ section.settings.subtitle }}
            </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 mb-12">
            {% for block in section.blocks %}
            <div class="glass-effect rounded-2xl p-8 text-center hover:scale-105 transition-transform duration-300 animate-scale-in delay-{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
                <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white text-xl font-bold">
                    {{ forloop.index }}
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">{{ block.settings.heading }}</h3>
                <p class="text-gray-600 text-sm">{{ block.settings.text }}</p>
            </div>
            {% endfor %}
        </div>

        <div class="glass-effect rounded-3xl p-8 md:p-10 max-w-4xl mx-auto animate-fade-in-up delay-300">
            <div class="grid md:grid-cols-[auto,1fr] gap-6 items-center">
                {% if payment_product != blank and payment_product.featured_image != blank %}
                <img src="{{ payment_product.featured_image | img_url: '600x' }}" alt="{{ payment_product.featured_image.alt | default: payment_product.title }}" class="w-32 h-32 md:w-40 md:h-40 rounded-2xl object-cover shadow-lg mx-auto">
                {% endif %}
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">
                        {{ section.settings.card_title }}
                    </h2>
                    <p class="text-gray-600 mb-6">
                        {{ section.settings.card_text }}
                    </p>
                    <div class="flex flex-wrap gap-3 mb-6">
                        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 border border-pink-100 rounded-full text-sm font-semibold text-gray-700">
                            <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            <span>{{ section.settings.trust_badge_1 }}</span>
                        </span>
                        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 border border-pink-100 rounded-full text-sm font-semibold text-gray-700">
                            <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            <span>{{ section.settings.trust_badge_2 }}</span>
                        </span>
                        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 border border-pink-100 rounded-full text-sm font-semibold text-gray-700">
                            <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            <span>{{ section.settings.trust_badge_3 }}</span>
                        </span>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        {% if payment_product != blank %}
                        <a href="{{ payment_product.url }}" class="px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-lg hover:scale-105 transition-transform duration-300 text-center">
                            {{ section.settings.cta_product }}
                        </a>
                        {% endif %}
                        <a href="{{ section.settings.cta_checkout_url | default: routes.cart_url }}" class="px-8 py-4 glass-effect rounded-full text-gray-800 font-bold text-lg hover:bg-pink-50 transition-all duration-300 border-2 border-pink-300 text-center">
                            {{ section.settings.cta_checkout }}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <p class="text-center text-sm text-gray-500 mt-8">
            {{ section.settings.footer_note }}
        </p>
    </div>
</section>

{% schema %}
{
  "name": "Payment Steps",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit associé"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Finalisez votre commande"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Le paiement se fait via la plateforme Shopify, 100% sécurisée."
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Titre encadré",
      "default": "Paiement sécurisé & suivi complet"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Texte encadré",
      "default": "Une fois votre Reformer ajouté au panier, vous serez guidé(e) pas à pas pour renseigner vos informations et confirmer votre paiement."
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Réassurance 1",
      "default": "Paiement SSL sécurisé"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Réassurance 2",
      "default": "Livraison suivie 5-7 jours"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Réassurance 3",
      "default": "Garantie 2 ans incluse"
    },
    {
      "type": "text",
      "id": "cta_product",
      "label": "CTA produit",
      "default": "Revenir au produit"
    },
    {
      "type": "text",
      "id": "cta_checkout",
      "label": "CTA paiement",
      "default": "Accéder au panier"
    },
    {
      "type": "url",
      "id": "cta_checkout_url",
      "label": "URL panier/paiement"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Note de bas de page",
      "default": "Besoin d'aide ? Contactez-nous avant de finaliser votre commande."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Ajoutez au panier"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Choisissez votre Reformer, la quantité, puis ajoutez-le au panier."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Ajoutez au panier",
            "text": "Sélectionnez votre Reformer et ajoutez-le au panier."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Renseignez vos infos",
            "text": "Adresse, livraison et coordonnées pour un suivi rapide."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Confirmez votre paiement",
            "text": "Paiement sécurisé par Shopify, reçu instantané."
          }
        }
      ]
    }
  ]
}
{% endschema %}
