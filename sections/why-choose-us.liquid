<section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto">
        <h2 class="font-display text-5xl md:text-6xl font-bold text-center mb-16 animate-fade-in-up">
            <span class="gradient-text">{{ section.settings.title }}</span>
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8">
            {% for block in section.blocks %}
            <div class="glass-effect rounded-2xl p-8 hover:scale-105 transition-transform duration-300 animate-slide-in-left delay-{{ forloop.index | times: 200 }}" {{ block.shopify_attributes }}>
                <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center mb-6 mx-auto">
                    {{ block.settings.icon }}
                </div>
                <h3 class="text-2xl font-bold mb-4 text-center text-gray-800">{{ block.settings.heading }}</h3>
                <p class="text-gray-600 text-center">{{ block.settings.text }}</p>
            </div>
            {% endfor %}
        </div>
        
        {% if section.settings.cta_text != blank %}
        <div class="text-center mt-12 animate-fade-in-up delay-700">
            <a href="{{ section.settings.cta_url }}" class="inline-block px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-xl hover:scale-110 transition-transform duration-300 animate-pulse-glow">
                {{ section.settings.cta_text }} →
            </a>
        </div>
        {% endif %}
    </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Pourquoi Choisir OnaPilates ?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Je Veux Mon Reformer Maintenant"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG or Emoji)",
          "default": "<svg class=\"w-8 h-8 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "Qualité Premium",
            "text": "Reformer professionnel conçu pour durer"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Expertise Pilates",
            "text": "Conçu par des experts du Pilates"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Bien-être Garanti",
            "text": "Transformez votre santé et votre bien-être"
          }
        }
      ]
    }
  ]
}
{% endschema %}
