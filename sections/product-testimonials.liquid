<section class="py-20 px-6 bg-white">
    <div class="container mx-auto max-w-6xl">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-16 animate-fade-in-up">
            <span class="gradient-text">{{ section.settings.title }}</span>
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8">
            {% for block in section.blocks %}
            <div class="glass-effect rounded-2xl p-8 hover:scale-105 transition-transform duration-300 animate-slide-in-left delay-{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
                <div class="flex items-center gap-1 mb-4">
                    {% for i in (1..5) %}
                    <svg class="w-5 h-5 {% if i <= block.settings.rating %}text-yellow-400{% else %}text-gray-300{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    {% endfor %}
                </div>
                <p class="text-gray-600 mb-6 italic">"{{ block.settings.text }}"</p>
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center">
                        <span class="text-white font-bold">{{ block.settings.name | slice: 0, 1 }}</span>
                    </div>
                    <div>
                        <div class="font-bold text-gray-800">{{ block.settings.name }}</div>
                        <div class="text-sm text-gray-500">{{ block.settings.location }}</div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Product Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ce Que Disent Nos Clients"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "Excellent produit, je recommande vivement !"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Marie D."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Paris, France"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Excellent produit, je recommande vivement !",
            "name": "Marie D.",
            "location": "Paris, France"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Transformé ma pratique du Pilates, merci !",
            "name": "Sophie L.",
            "location": "Lyon, France"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Qualité professionnelle, je suis ravie !",
            "name": "Julie M.",
            "location": "Marseille, France"
          }
        }
      ]
    }
  ]
}
{% endschema %}
