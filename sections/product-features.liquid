<section class="py-20 px-6 bg-white">
    <div class="container mx-auto">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-16 animate-fade-in-up">
            <span class="gradient-text">{{ section.settings.title }}</span>
        </h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {% for block in section.blocks %}
            <div class="glass-effect rounded-2xl p-8 hover:scale-105 transition-transform duration-300 animate-slide-in-left delay-{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
                <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center mb-6">
                    <span class="text-3xl">{{ block.settings.icon }}</span>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-800">{{ block.settings.heading }}</h3>
                <p class="text-gray-600">{{ block.settings.text }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Product Features",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Caractéristiques du Produit"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Features"
    }
  ]
}
{% endschema %}
