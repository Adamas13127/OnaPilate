<section class="pt-40 md:pt-44 pb-20 px-6 relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-20 left-10 w-96 h-96 bg-pink-200/30 rounded-full blur-3xl animate-float"></div>
        <div class="absolute bottom-20 right-10 w-80 h-80 bg-purple-200/30 rounded-full blur-3xl animate-float delay-500"></div>
        <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-pink-200/20 rounded-full blur-3xl animate-rotate"></div>
    </div>
    
    <div class="container mx-auto relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="animate-scale-in delay-200">
                <div class="relative rounded-3xl overflow-hidden shadow-2xl">
                    <div id="productCarousel" class="carousel-container relative overflow-hidden">
                        <div id="productSlides" class="flex carousel-slide" style="transform: translateX(0%);">
                            {% for image in product.images %}
                            <div class="min-w-full">
                                <img src="{{ image | img_url: '1200x' }}" alt="{{ image.alt }}" class="w-full h-auto object-cover">
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <button type="button" id="productPrev" class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-3 shadow-lg transition-all hover:scale-110 z-20 cursor-pointer">
                        <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </button>
                    <button type="button" id="productNext" class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-3 shadow-lg transition-all hover:scale-110 z-20 cursor-pointer">
                        <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </button>
                    
                    <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-10">
                        {% for image in product.images %}
                        <button class="carousel-dot w-2.5 h-2.5 rounded-full bg-white/80 {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></button>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <div class="animate-slide-in-right delay-300">
                <h1 class="font-display text-5xl md:text-6xl font-bold mb-6">
                    <span class="gradient-text">{{ product.title }}</span>
                </h1>
                <p class="text-2xl text-gray-700 mb-4">{{ section.settings.subtitle }}</p>
                <div class="text-lg text-gray-600 mb-8">
                    {{ product.description }}
                </div>
                
                <div class="mb-8 animate-scale-in delay-500">
                    <div class="flex items-baseline gap-4 mb-4">
                        <span class="text-5xl font-bold gradient-text">{{ product.price | money }}</span>
                        {% if product.compare_at_price > product.price %}
                        <span class="text-xl text-gray-400 line-through">{{ product.compare_at_price | money }}</span>
                        <span class="px-3 py-1 bg-pink-100 rounded-full text-pink-600 text-sm font-semibold">
                            -{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
                        </span>
                        {% endif %}
                    </div>
                    <p class="text-gray-500">{{ section.settings.shipping_info }}</p>
                </div>
                
                <div class="animate-fade-in-up delay-600" id="acheter">
                    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" class="w-full px-8 py-5 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-xl hover:scale-105 transition-transform duration-300 animate-pulse-glow">
                            💳 Acheter Maintenant
                        </button>
                    </form>
                </div>
                
                <div class="mt-8 flex flex-wrap gap-4 animate-fade-in-up delay-700">
                    {% for block in section.blocks %}
                    <div class="flex items-center gap-2 text-sm text-gray-600" {{ block.shopify_attributes }}>
                        <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                        <span>{{ block.settings.text }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Product Hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Votre Studio de Pilates Professionnel à la Maison"
    },
    {
      "type": "text",
      "id": "shipping_info",
      "label": "Shipping Info",
      "default": "Livraison gratuite • Garantie 2 ans"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Livraison sécurisée"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "text": "Livraison sécurisée"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "Garantie 2 ans"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "Retour gratuit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
