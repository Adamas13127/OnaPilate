{% assign main_product = all_products[settings.main_product] %}
{% if main_product == blank and collections.all.products.first %}
  {% assign main_product = collections.all.products.first %}
{% endif %}
{% assign cta_url = section.settings.cta_url | default: main_product.url %}

<section class="py-20 px-6 bg-white">
    <div class="container mx-auto">
        <h2 class="font-display text-5xl md:text-6xl font-bold text-center mb-16 animate-fade-in-up">
            <span class="gradient-text">{{ section.settings.title }}</span>
        </h2>
        
        <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
            {% for block in section.blocks %}
            <div class="flex items-center justify-center gap-6 animate-slide-in-{% cycle 'left', 'right' %} delay-{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
                <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center">
                    <span class="text-2xl">{{ block.settings.icon }}</span>
                </div>
                <div class="text-center md:text-left">
                    <h3 class="text-2xl font-bold mb-3 text-gray-800">{{ block.settings.heading }}</h3>
                    <p class="text-gray-600">{{ block.settings.text }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
        
        {% if section.settings.cta_text != blank and cta_url != blank %}
        <div class="text-center mt-16 animate-scale-in delay-800">
            <a href="{{ cta_url }}" class="inline-block px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-xl hover:scale-110 transition-transform duration-300 animate-pulse-glow">
                {{ section.settings.cta_text }} →
            </a>
        </div>
        {% endif %}
    </div>
</section>

{% schema %}
{
  "name": "Advantages",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Les Avantages d'un Reformer à la Maison"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Commencer Ma Transformation"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "advantage",
      "name": "Advantage",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🏠"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Advantage Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Advantage description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advantages",
      "blocks": [
        {
          "type": "advantage",
          "settings": {
            "icon": "🏠",
            "heading": "Pratiquez Quand Vous Voulez",
            "text": "Plus besoin de réserver un créneau ou de vous déplacer"
          }
        },
        {
          "type": "advantage",
          "settings": {
            "icon": "💰",
            "heading": "Économisez sur le Long Terme",
            "text": "Un investissement unique qui remplace les abonnements mensuels"
          }
        }
      ]
    }
  ]
}
{% endschema %}
