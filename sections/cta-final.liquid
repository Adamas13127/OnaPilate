{% assign main_product = all_products[settings.main_product] %}
{% if main_product == blank and collections.all.products.first %}
  {% assign main_product = collections.all.products.first %}
{% endif %}
{% assign primary_cta_url = section.settings.cta_url_1 | default: main_product.url %}
{% assign secondary_cta_url = section.settings.cta_url_2 | default: main_product.url %}

<section class="py-20 px-6 bg-gradient-to-br from-pink-50 via-purple-50 to-gray-50 relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-10 right-10 w-64 h-64 bg-pink-200/30 rounded-full blur-3xl animate-float"></div>
        <div class="absolute bottom-10 left-10 w-80 h-80 bg-purple-200/30 rounded-full blur-3xl animate-float delay-500"></div>
    </div>
    
    <div class="container mx-auto max-w-4xl relative z-10">
        <div class="glass-effect rounded-3xl p-10 md:p-12 text-center animate-scale-in delay-200">
            <div class="inline-block px-4 py-2 bg-pink-100 rounded-full mb-6">
                <span class="text-pink-600 font-semibold text-sm">{{ section.settings.badge_text }}</span>
            </div>
            
            <h2 class="font-display text-4xl md:text-5xl font-bold mb-4 animate-fade-in-up">
                <span class="gradient-text">{{ section.settings.title }}</span>
            </h2>
            
            <p class="text-lg text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-in-up delay-200">
                {{ section.settings.description }}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-scale-in delay-400">
                {% if primary_cta_url != blank %}
                <a href="{{ primary_cta_url }}" class="group px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-bold text-lg hover:scale-105 transition-all duration-300 shadow-lg flex items-center gap-2">
                    <span>{{ section.settings.cta_text_1 }}</span>
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </a>
                {% endif %}
                {% if secondary_cta_url != blank %}
                <a href="{{ secondary_cta_url }}" class="px-8 py-4 glass-effect rounded-full text-gray-800 font-bold text-lg hover:bg-pink-50 transition-all duration-300 border-2 border-pink-300">
                    {{ section.settings.cta_text_2 }}
                </a>
                {% endif %}
            </div>
            
            <div class="mt-10 flex flex-wrap justify-center gap-6 text-gray-600 text-sm animate-fade-in-up delay-500">
                {% for block in section.blocks %}
                <div class="flex items-center gap-2" {{ block.shopify_attributes }}>
                    <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{{ block.settings.text }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "CTA Final",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "✨ Commencez Votre Transformation"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Prêt à Transformer Votre Vie ?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Rejoignez des milliers de personnes qui ont choisi OnaPilates pour leur bien-être quotidien"
    },
    {
      "type": "text",
      "id": "cta_text_1",
      "label": "CTA Button 1 Text",
      "default": "Acheter Maintenant"
    },
    {
      "type": "url",
      "id": "cta_url_1",
      "label": "CTA Button 1 URL"
    },
    {
      "type": "text",
      "id": "cta_text_2",
      "label": "CTA Button 2 Text",
      "default": "Découvrir le Produit"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "CTA Button 2 URL"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Livraison gratuite"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA Final",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Livraison gratuite"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Garantie 2 ans"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Retour gratuit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
