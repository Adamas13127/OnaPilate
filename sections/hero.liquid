<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-32 md:pt-36">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-20 left-10 w-72 h-72 bg-pink-200/30 rounded-full blur-3xl animate-float"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-200/30 rounded-full blur-3xl animate-float delay-500"></div>
    </div>
    
    <div class="relative z-10 container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="text-left animate-fade-in-up">
                <h1 class="font-display text-6xl md:text-8xl font-bold mb-6">
                    <span class="gradient-text">{{ section.settings.hero_title }}</span>
                </h1>
                <p class="text-3xl md:text-4xl text-gray-800 mb-4 animate-fade-in-up delay-200">
                    {{ section.settings.hero_subtitle }}
                </p>
                <p class="text-lg md:text-xl text-gray-600 mb-12 animate-fade-in-up delay-300">
                    {{ section.settings.hero_description }}
                </p>
                <div class="flex flex-col sm:flex-row gap-4 animate-scale-in delay-400">
                    {% if section.settings.cta_url_1 != blank %}
                    <a href="{{ section.settings.cta_url_1 }}" class="px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white font-semibold text-lg hover:scale-110 transition-transform duration-300 animate-pulse-glow text-center">
                        {{ section.settings.cta_text_1 }} →
                    </a>
                    {% endif %}
                    {% if section.settings.cta_url_2 != blank %}
                    <a href="{{ section.settings.cta_url_2 }}" class="px-8 py-4 glass-effect rounded-full text-gray-800 font-semibold text-lg hover:bg-pink-50 transition-all duration-300 border-2 border-pink-300 text-center">
                        {{ section.settings.cta_text_2 }}
                    </a>
                    {% endif %}
                </div>
            </div>
            {% if section.settings.hero_image != blank %}
            <div class="animate-scale-in delay-500">
                <img src="{{ section.settings.hero_image | img_url: '1200x' }}" alt="{{ section.settings.hero_image.alt }}" class="rounded-3xl shadow-2xl w-full h-auto object-cover animate-float">
            </div>
            {% endif %}
        </div>
    </div>
    
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "OnaPilates"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Votre Studio de Pilates à la Maison"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Découvrez le Reformer qui transformera votre pratique du Pilates et votre bien-être quotidien"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "cta_text_1",
      "label": "CTA Button 1 Text",
      "default": "Découvrir le Reformer"
    },
    {
      "type": "url",
      "id": "cta_url_1",
      "label": "CTA Button 1 URL"
    },
    {
      "type": "text",
      "id": "cta_text_2",
      "label": "CTA Button 2 Text",
      "default": "Voir le Produit"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "CTA Button 2 URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
